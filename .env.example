# Copiar a .env.local (ignorado por git) y completar. Nunca commitear valores reales.

# Firma la cookie de acceso a las galerías. Sin esto se usa un valor de desarrollo.
GALERIAS_SECRETO=

# De dónde salen las imágenes en el sitio. Sin esto, https://img.ellentederomi.com.
# Para probar antes del dominio propio: la URL r2.dev del bucket público.
NEXT_PUBLIC_IMG_HOST=

# Base Postgres (feature 003). En Railway es la referencia a la variable de la base
# (red privada); acá, la URL pública del TCP proxy de esa misma base.
DATABASE_URL=

# Panel de Romi (feature 004). El mail y el hash son datos reales: solo acá y en Railway,
# nunca en el repo.
ADMIN_EMAIL=
# Hash scrypt de su contraseña: `npm run admin:clave` lo genera.
ADMIN_CLAVE_HASH=
# Firma la cookie de sesión del panel. Cambiarlo cierra todas las sesiones.
SESION_SECRETO=
# Autoriza a la app a despertar al worker (POST /procesar); el mismo valor en los dos.
WORKER_SECRETO=
# Dirección privada del worker en Railway (http://<servicio>.railway.internal:<puerto>);
# en local, http://localhost:<puerto> si se corre `npm run worker`.
WORKER_URL=

# Solo para `npm run fotos -- --subir` (contracts/cli-fotos.md de la feature 002).
# ID de la cuenta de Cloudflare: el endpoint es https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Token de R2 con escritura en los dos buckets.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket público, conectado a img.ellentederomi.com: solo derivadas.
R2_BUCKET=
# Bucket privado, sin acceso público: originales de las galerías.
R2_BUCKET_ORIGINALES=
